{
	"name": "skillswap/app",
	"description": "SkillSwap modular monolith architecture",
	"type": "project",
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Core\\": "core/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"serve": "php -S 127.0.0.1:8000 -t public",
		"migrate": "php database/migrate.php",
		"seed": "php database/seed.php",
		"test": "php vendor/bin/phpunit",
		"test:unit": "php vendor/bin/phpunit --testsuite Unit",
		"test:feature": "php vendor/bin/phpunit --testsuite Feature",
		"setup": [
			"@php database/migrate.php",
			"@php database/seed.php"
		]
	}
}
